# Build caches and local tooling
.cambc/
.venv/
.ruff_cache/
__pycache__/

# Replays and per-run match folders are regenerable. The results table, queue scripts and their
# logs are tracked so teammates can see and re-run every experiment.
matches/*
!matches/gauntlet.csv
!matches/*.sh
!matches/*.log
replays/

# Bots: only track the main bot, frozen versions and reference bots.
# Experiment variants made by tools/variant.py (and their seeded copies) stay local.
bots/*
!bots/mybot/
!bots/v1/
!bots/v2/
!bots/v3/
!bots/v4/
!bots/v5/
!bots/v6/
!bots/v7/
!bots/v8/
!bots/v9/
!bots/v10/
!bots/v11/
!bots/v12/
!bots/v13/
!bots/v14/
!bots/cpp13/
!bots/meta/
!bots/starter/
!bots/idle/
!bots/probe/
bots/*/.cambc/
bots/*/build/
bots/*/target/

# Packaged bot uploads
submissions/
!bots/cpp14/
!bots/cpp15/
!bots/cpp16/
!bots/cpp17/
!bots/cpp18/
!bots/cpp19/
!bots/cpp20/
